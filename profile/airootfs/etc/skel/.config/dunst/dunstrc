# LarpOS Blood Moon notifications
[global]
    origin = top-right
    offset = 12x48
    width = 350
    height = 120
    gap_size = 8
    padding = 12
    horizontal_padding = 14
    frame_width = 2
    frame_color = "#e0342f"
    corner_radius = 10
    font = JetBrainsMono Nerd Font 10
    separator_color = frame
    icon_position = left
    max_icon_size = 48
    idle_threshold = 120

[urgency_low]
    background = "#16161d"
    foreground = "#e8e6e3"
    timeout = 6

[urgency_normal]
    background = "#1a1a22"
    foreground = "#ffffff"
    timeout = 8

[urgency_critical]
    background = "#2a0d10"
    foreground = "#ffffff"
    frame_color = "#ff7a45"
    timeout = 0
